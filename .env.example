# Copy to .env for local development. Never commit real credentials.
# Required for persistent records and user accounts:
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME

# Session signing secret (use a long random value; Vercel has its own generated secret).
JWT_SECRET=

# Legacy Manus WebDev OAuth settings:
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=https://manus.im
OAUTH_SERVER_URL=https://api.manus.im
OWNER_OPEN_ID=

# Required only for AI demand forecasting via Manus Forge:
BUILT_IN_FORGE_API_URL=https://forge.manus.im
BUILT_IN_FORGE_API_KEY=
